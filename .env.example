# =============================================================================
# UCCD — Environment Variables Template
# Copy this file to .env and fill in your values.
# =============================================================================

# --- Database (PostgreSQL — Neon cloud or local Docker) ---
POSTGRES_URL=postgresql://neondb_owner:npg_YOUR_KEY@ep-YOUR_HOST.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
POSTGRES_PASSWORD=npg_YOUR_KEY
POSTGRES_SSLMODE=require

# --- Redis ---
REDIS_URL=redis://:uccd_redis_pass@localhost:6379/0
REDIS_PASSWORD=uccd_redis_pass

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9093

# --- JWT Authentication ---
SECRET_KEY=change-me-to-a-random-64-char-hex-string
JWT_ALG=HS256
JWT_EXPIRES_MINUTES=720

# --- Groq AI (LLM) ---
GROQ_API_KEY=gsk_your_groq_api_key_here

# --- Telegram Bot (optional) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
API_HOST=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://omniresol.me,https://www.omniresol.me

# --- Email (Mailgun) ---
MAILGUN_API_KEY=key-your_mailgun_api_key_here
MAILGUN_DOMAIN=mg-your-domain.mailgun.org
EMAIL_FROM_ADDRESS=support@unionbankofindia.com
MAILGUN_INBOUND_WEBHOOK_KEY=your_webhook_verification_key
# Set to 'true' to enable AI-powered two-stage email complaint intake (asks for details first)
EMAIL_COMPLAINTS_CONVERSATION_MODE=false

# --- Twitter/X (userbot) ---
TWITTER_USERNAME=your_twitter_username
TWITTER_PASSWORD=your_twitter_password
TWITTER_EMAIL=your_twitter_email
TWITTER_MONITOR_MENTIONS=true

# --- Instagram (userbot) ---
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
INSTAGRAM_SESSION_FILE=instagram_session.json
INSTAGRAM_VERIFICATION_HANDLER=console

# --- WhatsApp (open-wa) ---
OPENWA_BASE_URL=http://localhost:8081
OPENWA_API_KEY=uccd_whatsapp_key
# Webhook URL for incoming messages — OpenWA will POST message.received events here
# Docker internal: http://api:8000/api/v1/webhooks/whatsapp
OPENWA_WEBHOOK_URL=
OPENWA_SESSION_DATA_PATH=whatsapp_session.json

# --- Sarvam AI Translation ---
SARVAM_ACCESS_TOKEN=your_sarvam_api_key_here

# --- Demo Accounts (used by scripts/seed_users.py) ---
DEMO_SUPERVISOR_EMAIL=supervisor@example.com
DEMO_SUPERVISOR_PASSWORD=change-me
DEMO_AGENT_EMAIL=agent@example.com
DEMO_AGENT_PASSWORD=change-me
